+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {normalizeQuotes} from '../src/quote-compat.js';
+const reply=q=>JSON.stringify({issues:[{candidate_quote:q,requirement_quotes:['keep\\nall']}]});
+test('recover escaped layout only when whole quote occurs exactly in allowed evidence',()=>{
+  const out=normalizeQuotes(reply('first\\n\\nsecond'),'first\n\nsecond',[{text:'keep\nall'}]);
+  assert.equal(JSON.parse(out.text).issues[0].candidate_quote,'first\n\nsecond');
+  assert.equal(JSON.parse(out.text).issues[0].requirement_quotes[0],'keep\nall');
+  assert.equal(out.warnings.length,2);
+});
+test('preserve an already exact literal backslash sequence in code',()=>{
+  const text=reply('print("a\\nb")');
+  assert.equal(normalizeQuotes(text,'print("a\\nb")',[{text:'keep\\nall'}]).text,text);
+});
+test('recover a quote from a nested JSON answer only as an exact original substring',()=>{
+  const quote='first\\n\\nsecond';
+  const candidate=JSON.stringify({answer:quote});
+  const out=normalizeQuotes(reply(quote),candidate,[{text:'keep\\nall'}]);
+  assert(candidate.includes(JSON.parse(out.text).issues[0].candidate_quote));
+  assert.equal(out.warnings[0].strategy,'encode_json_string');
+});
+test('no fuzzy matching, ellipsis recovery or attribution to other source types',()=>{
+  const text=reply('first...second');
+  assert.equal(normalizeQuotes(text,'first\n\nsecond',[{text:'different'}]).text,text);
+  const other=reply('first\\nsecond');
+  assert.equal(normalizeQuotes(other,'first\nDIFFERENT\nsecond',[{text:'different'}]).text,other);
+});
+test('parse failure and unrelated fields are preserved',()=>{
+  assert.equal(normalizeQuotes('not JSON','x',[]).text,'not JSON');
+  const text=JSON.stringify({issues:[],diagnosis:'a\\nb'});
+  assert.equal(normalizeQuotes(text,'a\nb',[]).text,text);
+});
