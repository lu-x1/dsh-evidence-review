@@ -0,0 +1,29 @@
+// Diagnostic candidate only; not part of the frozen paid comparison.
+// Recover escaped layout characters only when the result is an exact excerpt
+// of the evidence that the existing validator already accepts as a source.
+export function normalizeQuotes(text,candidate,refs) {
+  const warnings=[];
+  if(typeof text!=='string'||Buffer.byteLength(text)>96000)return {text,warnings};
+  let parsed;
+  try {
+    const fenced=/^```(?:json)?[ \t]*\r?\n([\s\S]*)\r?\n```$/.exec(text.trim());
+    parsed=JSON.parse(fenced?fenced[1]:text);
+  }catch{return {text,warnings};}
+  if(!parsed||!Array.isArray(parsed.issues))return {text,warnings};
+  function recover(value,sources,field,index) {
+    if(typeof value!=='string'||!value.trim()||sources.some(s=>s.includes(value)))return value;
+    const expanded=value.replace(/\\r\\n|\\n|\\r|\\t/g,s=>({'\\r\\n':'\r\n','\\n':'\n','\\r':'\r','\\t':'\t'})[s]);
+    const encoded=JSON.stringify(value).slice(1,-1);
+    const variants=[['decode_layout',expanded],['encode_json_string',encoded],['encode_json_string_twice',JSON.stringify(encoded).slice(1,-1)]];
+    for(const [strategy,represented] of variants)if(represented!==value&&sources.some(s=>s.includes(represented))) {
+      warnings.push({reason:'serialization_quote_recovered',field,index,strategy});return represented;
+    }
+    return value;
+  }
+  for(const [i,issue] of parsed.issues.entries()) {
+    if(!issue||typeof issue!=='object')continue;
+    issue.candidate_quote=recover(issue.candidate_quote,[candidate],'candidate_quote',i);
+    if(Array.isArray(issue.requirement_quotes))issue.requirement_quotes=issue.requirement_quotes.map((q,j)=>recover(q,refs.map(r=>r.text),`requirement_quotes.${j}`,i));
+  }
+  return {text:warnings.length?JSON.stringify(parsed):text,warnings};
+}
