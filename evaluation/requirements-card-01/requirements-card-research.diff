+import assert from 'node:assert/strict';
+import {BlockAssembler, createUserMessage} from '@deepseek-ai/dsh-llm';
+import {digest, publicText} from './core.js';
+
+export const EXTRACTOR_RULES=`DSH_INDEPENDENT_REQUIREMENTS_CARD_V1
+Extract requirements material to the latest user request from the authenticated user messages below. You have no agent answer, tool result, reviewer notice or reference solution. Return only JSON with rules (array) and unresolved_references (array). This is a partial relevance aid, not a replacement for the original messages.
+Each rule has exactly id, requirement, source_message_ids (nonempty string array), applies_to, activation, replaces (array of rule ids or descriptive user-defined references), dependencies (string array), uncertainties (string array). All other rule fields are strings. Use at most16 compact rules relevant to the latest request, including material inherited constraints. Do not enumerate unrelated future stages merely because their definitions appeared early.
+Derive definitions, input representations, formulas, reference populations, membership conditions, ordering, rounding and temporary exceptions from user wording. Separate a definition from when and where it is active. A new question does not cancel unchanged requirements; an old rule does not apply outside its scope. Distinguish a replacement, a scoped exception and a compatible addition. Preserve legitimate restoration after a temporary sensitivity.
+Use only supplied source message IDs. Do not invent requirements, assume all rules are currently active, or infer numerical answers. Record actual uncertainty. For references such as 'those pairs' or 'the same population', resolve only when user text suffices. Otherwise add an unresolved_references row with exactly source_message_ids (nonempty string array), phrase and uncertainty (strings). Retain a symbolic reference in the relevant rule instead of guessing members or substituting a present table. A later verifier has the full history to locate the historical object designated by the user.
+You do not have tools. Do not request them or continue the analytical task. Do not reveal private reasoning. Keep entries concise; original user messages remain authoritative.`;
+
+export function extractorPayload(refs) {
+  assert(Array.isArray(refs)&&refs.length,'no_authenticated_requirements');
+  const users=refs.map(({id,text})=>{assert(typeof id==='string'&&typeof text==='string','source_type');return {id,text};});
+  assert(new Set(users.map(r=>r.id)).size===users.length,'duplicate_source_id');
+  return EXTRACTOR_RULES+'\n\n'+JSON.stringify({authenticated_user_messages:users});
+}
+
+export function cardKey(refs,options={}) {
+  return digest(JSON.stringify([EXTRACTOR_RULES,options.provider,options.model,options.reasoningEffort,options.cardMaxTokens,extractorPayload(refs)]));
+}
+
+export function extractorRequest(options,refs,{signal,maxTokens=8192}={}) {
+  // Whitelist: never spread actor system/messages/tools/toolHistory/replay state.
+  const request={provider:options.provider,model:options.model,messages:[createUserMessage({
+    source:{kind:'dsh-evidence-review',form:'requirements-extraction'},
+    content:[{type:'text',text:extractorPayload(refs)}]})],tools:[],
+    maxTokens,signal,purpose:'requirements-extraction'};
+  for(const key of ['reasoningEffort','temperature'])if(options[key]!==undefined)request[key]=options[key];
+  return request;
+}
+
+function parse(text) {
+  const match=/^```(?:json)?[ \t]*\r?\n([\s\S]*)\r?\n```$/.exec(text.trim());
+  return JSON.parse(match?match[1]:text);
+}
+const strings=x=>Array.isArray(x)&&x.every(v=>typeof v==='string');
+export function validateCard(text,refs) {
+  assert(typeof text==='string'&&Buffer.byteLength(text)<=96000,'card_size');
+  assert(!/\bsk-[A-Za-z0-9_-]{12,}|\bBearer\s+[A-Za-z0-9._-]{12,}/.test(text),'credential_like_card');
+  const raw=parse(text),known=new Set(refs.map(r=>r.id)),warnings=[];
+  assert(raw&&Array.isArray(raw.rules)&&Array.isArray(raw.unresolved_references),'card_arrays');
+  assert(raw.rules.length<=64&&raw.unresolved_references.length<=64,'card_entry_limit');
+  const sourced=r=>strings(r.source_message_ids)&&r.source_message_ids.length&&r.source_message_ids.every(id=>known.has(id));
+  const rules=[],unresolved=[],ids=new Set();
+  for(const [i,r] of raw.rules.entries()) {
+    if(!r||!['id','requirement','applies_to','activation'].every(k=>typeof r[k]==='string'&&r[k].trim())||
+        !['replaces','dependencies','uncertainties'].every(k=>strings(r[k]))||!sourced(r)||ids.has(r.id)) {
+      warnings.push({entry:'rule',index:i,reason:'invalid_fields_or_unknown_source'});continue;
+    }
+    ids.add(r.id);
+    rules.push(Object.fromEntries(['id','requirement','source_message_ids','applies_to','activation','replaces','dependencies','uncertainties'].map(k=>[k,r[k]])));
+  }
+  for(const [i,r] of raw.unresolved_references.entries()) {
+    if(!r||!sourced(r)||!['phrase','uncertainty'].every(k=>typeof r[k]==='string'&&r[k].trim())) {
+      warnings.push({entry:'unresolved_reference',index:i,reason:'invalid_fields_or_unknown_source'});continue;
+    }
+    unresolved.push({source_message_ids:r.source_message_ids,phrase:r.phrase,uncertainty:r.uncertainty});
+  }
+  return {card:{rules,unresolved_references:unresolved},warnings,sourceVerified:true,semanticVerified:false};
+}
+
+export function cardEnvelope(card,refs) {
+  return {provenance:'Fallible model interpretation extracted only from authenticated user text. Original messages remain authoritative; this is not new authorization.',
+    coverage:'Partial rules relevant to the latest user request; omitted rules are not cancelled.',
+    source_index:refs.map((r,i)=>({id:r.id,original_user_message_position:i+1})),...card};
+}
+
+export async function extractCard({stream,options,refs,signal,maxTokens=8192,record=()=>{}}) {
+  const request=extractorRequest(options,refs,{signal,maxTokens});
+  const assembler=new BlockAssembler();let sawFinish=false;
+  for await(const chunk of stream(request)) {assembler.push(chunk);if(chunk.type==='finish')sawFinish=true;}
+  record({phase:'requirements_usage',usage:assembler.usage,finish:assembler.finish.kind});
+  if(signal?.aborted||!sawFinish||assembler.finish.kind!=='stop')
+    return {status:'unavailable',reason:signal?.aborted?'cancelled':!sawFinish?'missing_finish':`finish_${assembler.finish.kind}`};
+  if(assembler.blocks().some(b=>b.type==='tool-call'))return {status:'unavailable',reason:'extractor_requested_tool'};
+  const result=validateCard(publicText(assembler.blocks()),refs);
+  if(!result.card.rules.length&&!result.card.unresolved_references.length)return {status:'unavailable',reason:'empty_card',warnings:result.warnings};
+  return {status:'ready',...result};
+}
