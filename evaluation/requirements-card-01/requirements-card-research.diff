+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {randomUUID} from 'node:crypto';
+import {Context} from '@deepseek-ai/cordis';
+import {SessionStore,SessionId} from '@deepseek-ai/dsh-session';
+import {AgentRegistry} from '@deepseek-ai/dsh-agent';
+import {AgentLoop} from '@deepseek-ai/dsh-agent-loop';
+import {LlmRuntime,LlmAdapter,createUserMessage,isAgentLoopRequest} from '@deepseek-ai/dsh-llm';
+import {ToolRuntime} from '@deepseek-ai/dsh-tools';
+import {SystemPrompt} from '@deepseek-ai/dsh-system-prompt';
+import {SessionProjectionRegistry} from '@deepseek-ai/dsh-session-projection';
+import {publicText,tail} from '../src/core.js';
+import * as plugin from '../src/index.js';
+import {extractorRequest,extractorPayload,validateCard,extractCard,cardKey,cardEnvelope} from '../src/requirements-card.js';
+
+const refs=[{id:'m1',text:'Keep all rows.'}];
+const makeCard=(id='m1')=>({rules:[{id:'r1',requirement:'Keep all rows.',source_message_ids:[id],
+  applies_to:'requested analysis',activation:'current request',replaces:[],dependencies:[],uncertainties:[]}],unresolved_references:[]});
+
+test('extractor whitelist excludes actor system, history, tool schemas and opaque fields',()=>{
+  const options={provider:'fixture',model:'script',reasoningEffort:'high',temperature:0.2,
+    system:'ACTOR_SECRET',messages:[{role:'assistant',content:'ACTOR_SECRET'}],tools:[{description:'ACTOR_SECRET'}],toolHistory:{secret:'ACTOR_SECRET'}};
+  Object.defineProperty(options,'replayState',{get(){throw Error('opaque state read');}});
+  const request=extractorRequest(options,refs);
+  assert(!JSON.stringify(request).includes('ACTOR_SECRET'));
+  assert.deepEqual(request.tools,[]);assert.equal(request.reasoningEffort,'high');
+  assert.equal(request.purpose,'requirements-extraction');assert(!isAgentLoopRequest(request));
+  assert.deepEqual(JSON.parse(publicText(request.messages[0].content).split('\n\n')[1]).authenticated_user_messages,refs);
+});
+
+test('source references are checked locally without rejecting other good rows or paraphrases',()=>{
+  const card=makeCard();card.rules.push({...card.rules[0],id:'bad',source_message_ids:['invented']});
+  card.rules[0].requirement='Retain the entire authorized population.';
+  const out=validateCard('```json\n'+JSON.stringify(card)+'\n```',refs);
+  assert.equal(out.card.rules.length,1);assert.equal(out.warnings.length,1);
+  assert.equal(out.semanticVerified,false);
+});
+
+test('unresolved symbolic reference survives; tool/assistant source cannot create authority',()=>{
+  const raw={rules:[],unresolved_references:[{source_message_ids:['m1'],phrase:'the same rows',uncertainty:'members require historical binding'},
+    {source_message_ids:['tool-1'],phrase:'all rows',uncertainty:'tool said so'}]};
+  const out=validateCard(JSON.stringify(raw),refs);
+  assert.equal(out.card.unresolved_references.length,1);assert.equal(out.warnings.length,1);
+  assert(!JSON.stringify(cardEnvelope(out.card,refs)).includes('tool-1'));
+});
+
+test('card cache key changes for user updates, order and model settings',()=>{
+  const a=cardKey(refs,{provider:'p',model:'m',reasoningEffort:'high'});
+  assert.notEqual(a,cardKey([...refs,{id:'m8',text:'Use only the current rows.'}],{provider:'p',model:'m',reasoningEffort:'high'}));
+  assert.notEqual(a,cardKey(refs,{provider:'p',model:'m',reasoningEffort:'low'}));
+});
+
+test('card envelope preserves original review rules, user text, candidate and output schema',()=>{
+  const plain=tail('candidate',refs),withCard=tail('candidate',refs,{requirementsCard:cardEnvelope(makeCard(),refs)});
+  assert.equal(plain.split('\n\n')[0],withCard.split('\n\n')[0]);
+  const a=JSON.parse(plain.split('\n\n')[1]),b=JSON.parse(withCard.split('\n\n')[1]);
+  delete b.requirements_card;assert.deepEqual(a,b);
+});
+
+for(const finish of ['length','tool-calls','stop'])test(`extraction failure ${finish} is unavailable and never executes tools`,async()=>{
+  let n=0;
+  const stream=async function*(){n++;yield {type:'block-end',index:0,block:finish==='stop'
+    ?{type:'text',text:JSON.stringify({rules:[],unresolved_references:[]})}
+    :{type:'tool-call',id:'x',name:'bash',arguments:'{"command":"never"}'}};
+    yield {type:'finish',reason:{kind:finish}};};
+  const out=await extractCard({stream,options:{provider:'fixture',model:'script'},refs});
+  assert.equal(out.status,'unavailable');assert.equal(n,1);
+});
+
+async function nativeFixture(t,{failed=false}={}) {
+  const ctx=new Context();t.after(()=>ctx.fiber.dispose());const load=p=>ctx.plugin(p).await();
+  for(const p of [SessionStore,SessionProjectionRegistry,SystemPrompt,ToolRuntime])await load(p);
+  await load(await import('@deepseek-ai/dsh-tool-executor-native'));await load(AgentRegistry);await load(LlmRuntime);
+  await ctx.plugin(AgentLoop,{agents:[],maxParallelToolCalls:1}).await();
+  await ctx.plugin(plugin,{every:2,cardTimeoutMs:2000,timeoutMs:2000}).await();
+  ctx.tools.register({name:'noop',description:'fixture tool',parameters:{type:'object',properties:{}},
+    output:{schema:{type:'object'},render:()=>[{type:'text',text:'ACTOR_TOOL_SECRET'}]},execute:async()=>({})});
+  let actor=0,extractions=0,reviews=0;const seen=[];
+  ctx.llm.registerAdapter(['fixture'],new class extends LlmAdapter {
+    async resolveModel(provider,model){return {provider,id:model,name:model,reasoning:{efforts:[{id:'low',name:'Low'},{id:'high',name:'High'}]}};}
+    async *stream(req) {
+      let block,finish='stop';
+      if(req.purpose==='requirements-extraction') {
+        extractions++;assert(!JSON.stringify(req.messages).includes('ACTOR_ONLY_MARKER'));assert(!JSON.stringify(req.messages).includes('ACTOR_TOOL_SECRET'));
+        assert.deepEqual(req.tools,[]);assert.equal(req.maxTokens,8192);assert.equal(req.reasoningEffort,'low');
+        const users=JSON.parse(publicText(req.messages[0].content).split('\n\n')[1]).authenticated_user_messages;
+        block={type:'text',text:failed?'{':JSON.stringify(makeCard(users[0].id))};
+        if(failed)finish='length';
+      }else if(req.purpose==='evidence-review') {
+        reviews++;const source=seen.at(-1);assert.deepEqual(req.messages.slice(0,source.messages.length),source.messages);
+        assert.deepEqual(req.tools,source.tools);assert.equal(req.maxTokens,16384);assert.equal(req.reasoningEffort,'high');
+        const x=JSON.parse(publicText(req.messages[source.messages.length].content).split('\n\n')[1]);
+        assert.equal(Boolean(x.requirements_card),!failed);
+        const bad=x.candidate.includes('drop_rows');
+        block={type:'text',text:JSON.stringify({assessment:bad?'drift':'on-track',audit:['objective','scope','method'].map(dimension=>({
+          dimension,requirement:'Keep all rows.',requirement_quotes:['Keep all rows.'],updates:[],
+          observed:x.candidate,evidence_quotes:[x.candidate],status:bad&&dimension==='scope'?'conflict':'consistent'})),
+          issues:bad?[{candidate_quote:x.candidate,requirement_quotes:['Keep all rows.'],diagnosis:'removes required rows',reminder:'Restore the required rows.'}]:[]})};
+      }else {
+        actor++;seen.push(req);
+        assert(!JSON.stringify(req.messages).includes('DSH_INDEPENDENT_REQUIREMENTS_CARD_V1'));
+        assert(!JSON.stringify(req.messages).includes('source_message_ids'));
+        block=[1,2,3,5].includes(actor)?{type:'tool-call',id:randomUUID(),name:'noop',arguments:JSON.stringify({command:actor===2?'ACTOR_ONLY_MARKER drop_rows':'ACTOR_ONLY_MARKER keep_rows'})}:{type:'text',text:'Completed.'};
+        if(block.type==='tool-call')finish='tool-calls';
+      }
+      yield {type:'block-end',index:0,block};yield {type:'finish',reason:{kind:finish}};
+    }
+  }());
+  const handle=await ctx.agents.create({sessionId:SessionId(randomUUID()),agentOptions:{provider:'fixture',model:'script',reasoningEffort:'high'}});
+  handle.agent.followup(createUserMessage({source:{kind:'user'},content:[{type:'text',text:'Keep all rows.'}]}));
+  await handle.agent.whenIdle();
+  assert.equal(actor,4);assert.equal(extractions,1);assert.equal(reviews,2);
+  handle.agent.followup(createUserMessage({source:{kind:'user'},content:[{type:'text',text:'Continue while keeping all rows.'}]}));
+  await handle.agent.whenIdle();
+  assert.equal(actor,6);assert.equal(extractions,2);assert.equal(reviews,3);
+  const rows=handle.agent.session.snapshotEvents().filter(e=>e.type===plugin.RECORD_TYPE).map(e=>e.data);
+  assert.deepEqual(rows.filter(r=>r.phase==='check').map(r=>r.ordinal),[2,4,6]);
+  assert.equal(rows.filter(r=>r.phase==='delivery').length,1);
+  assert(seen[2].messages.some(m=>m.source?.form==='notice'));
+  return rows;
+}
+
+test('real DSH loop keeps extraction separate, reuses unchanged card and refreshes on user update',async t=>{
+  const rows=await nativeFixture(t);assert.equal(rows.filter(r=>r.phase==='requirements_card').length,2);
+  assert.equal(rows.filter(r=>r.phase==='requirements_card_reused').length,1);
+});
+test('failed extraction falls back to baseline and is not retried until user messages change',async t=>{
+  const rows=await nativeFixture(t,{failed:true});assert.equal(rows.filter(r=>r.phase==='requirements_card_failed').length,2);
+  assert.equal(rows.filter(r=>r.phase==='requirements_card_reused').length,1);
+});
